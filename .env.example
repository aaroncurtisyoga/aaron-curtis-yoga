# Copy to .env.local and fill in. Names only, no real values.
#
# The app reads .env.local, but the Prisma CLI only reads .env. Put the two
# POSTGRES_ URLs in .env as well before running `prisma migrate deploy`, or use
# `npx dotenv-cli -e .env.local -- npx prisma <command>`.

# --- Database (required to boot) -------------------------------------------
# Pooled connection for the app, direct connection for migrations.
POSTGRES_PRISMA_URL=
POSTGRES_URL_NON_POOLING=

# --- Auth: Clerk (required to boot) ----------------------------------------
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Svix signing secret for the user-sync webhook.
CLERK_WEBHOOK_SECRET=
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/

# --- Payments: Stripe ------------------------------------------------------
# The server client is constructed at module scope, so a missing secret key
# throws on import rather than degrading.
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SIGNING_SECRET=

# --- Email: Resend ---------------------------------------------------------
RESEND_API_KEY=
RESEND_SEGMENT_ID=
RESEND_FROM_EMAIL=
RESEND_WEBHOOK_SECRET=

# --- Google ----------------------------------------------------------------
# Maps key covers both the event-page map and Places autocomplete in the admin form.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# Calendar runs on a service account, not OAuth. Base64-encode the private key.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY_BASE64=
GOOGLE_CALENDAR_ID=

# --- Event sync (scraping) -------------------------------------------------
# Both crawlers connect to Browserless and throw without a token. There is no
# local-Chromium fallback, on purpose.
BROWSERLESS_API_TOKEN=
# ZoomShift login for the DC Bouldering Project crawler.
ZOOMSHIFT_EMAIL=
ZOOMSHIFT_PASSWORD=

# --- Storage ---------------------------------------------------------------
BLOB_READ_WRITE_TOKEN=

# --- Cron ------------------------------------------------------------------
# Bearer token for the scheduled job. They 401 when it is unset.
CRON_SECRET=

# --- App -------------------------------------------------------------------
# Base URL used for Stripe return URLs and account-page links.
NEXT_PUBLIC_SERVER_URL=http://localhost:3000


# --- Local dev / testing (optional) ----------------------------------------
# Serve fixture events instead of hitting the database.
MOCK_EVENTS=
# Playwright base URL. CI points this at the deployed preview or production.
NEXT_PUBLIC_APP_URL=
# Enables @clerk/testing in e2e/global.setup.ts. Note the missing NEXT_PUBLIC_
# prefix: this is a separate name from the key above, not a duplicate.
CLERK_PUBLISHABLE_KEY=
E2E_CLERK_ADMIN_USERNAME=
E2E_CLERK_ADMIN_PASSWORD=
E2E_CLERK_USER_USERNAME=
E2E_CLERK_USER_PASSWORD=
